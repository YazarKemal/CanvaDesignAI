# Single-engine architecture: Architect, Generator and Reviewer all run on
# DeepSeek (OpenAI-API-compatible, reached via the openai SDK with a
# base_url override).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------------------------------------------------------------------------
# OpenAI Vision — used by the image-analysis features:
#   - src/template_ingest.py (template deconstruction)
#   - src/mockup_engine.py / mockup_api.py (AI Mockup Director)
# The legacy Architect→Generator→Reviewer design pipeline remains DeepSeek-only.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_VISION_MODEL=gpt-4o
