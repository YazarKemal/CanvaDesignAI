ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Used by src/image_provider.py to turn image_prompts.main_visual into a
# real image (Canva's own AI image generation is not exposed via its API).
OPENAI_API_KEY=

# Canva Connect API. Obtain via Canva's OAuth2 (authorization code + PKCE)
# flow (see https://www.canva.dev/docs/connect/authentication/) -- that
# interactive flow is not implemented in this project, so generate a token
# through Canva's own quickstart/Postman collection and paste it here.
CANVA_ACCESS_TOKEN=
CANVA_REFRESH_TOKEN=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
