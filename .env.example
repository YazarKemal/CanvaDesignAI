# Single-engine architecture: Architect, Generator and Reviewer all run on
# DeepSeek (OpenAI-API-compatible, reached via the openai SDK with a
# base_url override). No other LLM key is required by the pipeline.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------------------------------------------------------------------------
# Vision client (OpenAI) — used ONLY by src/template_ingest.py for offline
# template-image deconstruction.  The runtime Architect→Generator→Reviewer
# pipeline does NOT use this key — it remains DeepSeek-only.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_VISION_MODEL=gpt-4o
