# URL of the Python FastAPI engine (api.py). The Next.js /api/chat route
# proxies to it so the LLM keys stay server-side.
BACKEND_URL=http://127.0.0.1:8000

# URL of the Python Mockup Director service (mockup_api.py). The Next.js
# /api/mockup/* routes proxy to it. No secrets live in the frontend env.
MOCKUP_BACKEND_URL=http://127.0.0.1:8002
